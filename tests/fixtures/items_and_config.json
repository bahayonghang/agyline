      "expected_plain": "  \uef23 Opus 4.6 │ \uf49b 20% \u00b7 20k\n",
      "expected_ansi": "  \u001b[0m\u001b[0;96m\uef23 Opus 4.6\u001b[0;37m │ \u001b[0;95m\uf49b\u001b[0;95m 20%\u001b[0;37m \u00b7 \u001b[0;95m20k\u001b[0m\n"
    },
    {
      "id": "IC12_narrowing_stage2_and_stage3_cjk_zwj_pua",
